# Local dev: vite dev (workerd) reads .env / .dev.vars into process.env.
# Production: set secrets with `bunx wrangler secret put GITHUB_TOKEN` / `OPS_TOKEN`.

# GitHub personal access token (optional — increases API rate limits)
GITHUB_TOKEN=

# Bearer token for ops endpoints like /api/queue/github (required in production)
OPS_TOKEN=

# Public site URL used for metadata/OG tags (optional; inlined at build time)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
