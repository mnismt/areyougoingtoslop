# GitHub personal access token (optional — increases API rate limits)
GITHUB_TOKEN=

# Public site URL used for metadata/OG tags (optional)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# File path for feedback JSON storage (optional, default: .data/feedback.json)
FEEDBACK_STORAGE_PATH=.data/feedback.json

# Redis URL for the centralized GitHub request queue and leaderboard storage (required)
REDIS_URL=

# Bearer token for ops endpoints like /api/queue/github (required in production)
OPS_TOKEN=

# Optional queue tuning (simple single-service defaults are usually fine)
# GITHUB_QUEUE_WORKERS=4
# GITHUB_QUEUE_MAX_ATTEMPTS=4
# GITHUB_QUEUE_REQUEST_TIMEOUT_MS=30000
