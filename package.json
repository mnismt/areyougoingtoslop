{
  "name": "areyougoingtoslop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.4",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "deploy": "vite build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "rm -rf .test-build && tsc -p tsconfig.test.json && echo '{\"type\":\"commonjs\"}' > .test-build/package.json && node --test \".test-build/**/*.test.js\"",
    "format": "biome check --write .",
    "gen:icons": "bun run scripts/generate-icons.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "motion": "^12.35.2",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-server-dom-webpack": "^19.2.7",
    "react-share": "^5.2.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vinext": "^1.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@cloudflare/vite-plugin": "^1.62.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "@vitejs/plugin-rsc": "^0.5.35",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8",
    "wrangler": "^4"
  }
}
